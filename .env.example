# .env.example — modèle de configuration du Cockpit
# --------------------------------------------------
# Copie ce fichier en « .env » (sans .example) et mets tes vraies valeurs.
# Le vrai .env n'est JAMAIS versionné (voir .gitignore) : c'est là que vivent
# les variables sensibles. Toutes ces variables sont optionnelles : sans .env,
# le dashboard tourne avec les valeurs par défaut de config.py.

# --- Données ---
# Nom du fichier CSV à charger (dans le dossier du projet)
COCKPIT_DATA_FILE=ventes_maison_lauret.csv

# --- Paramètres métier ---
COCKPIT_OBJECTIF_CROISSANCE=1.08     # objectif de croissance vs N-1 (1.08 = +8 %)
COCKPIT_SEUIL_ALERTE=10              # seuil d'alerte en % de variation
COCKPIT_HORIZON_PREVISION=12         # horizon de prévision en mois

# --- Splash ---
COCKPIT_SPLASH_VIDEO=cockpit_logo.mp4   # nom du fichier vidéo dans assets/

# --- Secret d'accès (optionnel, pour un futur écran de connexion) ---
# Laisse vide = aucune protection. Mets une valeur pour activer plus tard.
COCKPIT_ACCESS_PASSWORD=
