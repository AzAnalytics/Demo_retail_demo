# Environnement Python (propre à chaque machine — ne jamais versionner)
venv/
.venv/
env/

# Caches Python
__pycache__/
*.py[cod]
*.egg-info/

# Secrets & variables d'environnement (JAMAIS versionnés)
.env
.env.*
!.env.example
*.env
.streamlit/secrets.toml

# Les comptes et périmètres d'un client (empreintes de mots de passe)
profils.json
!profils.example.json

# Logs / temporaires
st.log
*.log

# macOS
.DS_Store
._*

# Outils agent / environnement de dev — jamais versionnés
.agents/
.claude/
.cursor/
.vscode/

# Vidéo du logo (générée via Gemini, souvent lourde — décommente si tu veux la versionner)
# assets/cockpit_logo.mp4
